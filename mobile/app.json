{
  "expo": {
    "name": "OpenCall",
    "slug": "opencall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.opencall.receptionist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record your voice so the assistant can speak in it, and talk to the assistant.",
        "NSContactsUsageDescription": "So the assistant knows which callers are your saved contacts.",
        "NSLocationWhenInUseUsageDescription": "Pin your delivery location on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.opencall.receptionist",
      "permissions": [
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_ANDROID_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pin your delivery location on the map."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "So the assistant knows which callers are your saved contacts."
        }
      ]
    ],
    "scheme": "opencall",
    "experiments": {
      "typedRoutes": false
    }
  }
}