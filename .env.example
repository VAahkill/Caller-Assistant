# Shared secret for the mobile app. Use a long random string: openssl rand -hex 24
OPENCALL_API_TOKEN=change-me
# Public HTTPS address of this server (e.g. a free Cloudflare Tunnel).
OPENCALL_PUBLIC_URL=https://opencall.example.com

# --- LLM: local Ollama (default) ---------------------------------------------
OPENCALL_LLM_BASE_URL=http://ollama:11434/v1
OPENCALL_LLM_API_KEY=ollama
OPENCALL_LLM_MODEL=llama3.1:8b
# --- or Groq's free tier (fast, needs a free API key) -------------------------
# OPENCALL_LLM_BASE_URL=https://api.groq.com/openai/v1
# OPENCALL_LLM_API_KEY=gsk_...
# OPENCALL_LLM_MODEL=llama-3.1-8b-instant

# --- Speech -----------------------------------------------------------------
# Use "small" on a CPU-only machine.
OPENCALL_WHISPER_MODEL=large-v3-turbo
# "silero" handles noisy lines better; "energy" needs no extra install.
OPENCALL_VAD_PROVIDER=silero
OPENCALL_DEFAULT_VOICE=kokoro:af_heart

# --- Telephony: Asterisk (recommended) -----------------------------------------
OPENCALL_ASTERISK_ARI_URL=http://host.docker.internal:8088/ari
OPENCALL_ASTERISK_ARI_USER=opencall
OPENCALL_ASTERISK_ARI_PASSWORD=change-me-too
OPENCALL_ASTERISK_OUTBOUND_ENDPOINT=PJSIP/{number}@trunk

# --- or Twilio --------------------------------------------------------------
# OPENCALL_TWILIO_ACCOUNT_SID=AC...
# OPENCALL_TWILIO_AUTH_TOKEN=...
# OPENCALL_TWILIO_FROM_NUMBER=+1...
