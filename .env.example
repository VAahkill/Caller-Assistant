# Everything below is free. Nothing here needs a card or a paid account.

# Shared secret for the mobile app. Use a long random string: openssl rand -hex 24
OPENCALL_API_TOKEN=change-me
# Address the app uses to reach this server: your home Wi-Fi IP, your free
# Tailscale address (works away from home), or a free trycloudflare.com URL.
OPENCALL_PUBLIC_URL=http://192.168.1.10:8000

# --- LLM: local Ollama (default, runs on your machine) -----------------------
OPENCALL_LLM_BASE_URL=http://ollama:11434/v1
OPENCALL_LLM_API_KEY=ollama
# Chosen by measurement among small free models (docs/ARCHITECTURE.md, "Choosing
# the language model"). Docker Compose pulls it the first time Ollama starts.
OPENCALL_LLM_MODEL=qwen3:4b-instruct
# Extra fields for every request, as JSON. The default turns off "thinking" (a
# model that reasons before answering keeps the caller waiting).
# OPENCALL_LLM_EXTRA_BODY={"reasoning_effort": "none"}
# A local model on a CPU can take a few minutes to load the first time. Replies
# wait this long for the first word (the caller hears "One moment, please" after
# 2.5 s), and the model is loaded at start-up, before the first call.
# OPENCALL_LLM_FIRST_TOKEN_TIMEOUT_S=180
# OPENCALL_FILLER_AFTER_S=2.5
# --- or a free cloud tier if your computer is too slow (free key, no card) ---
# Optional: the call's words then go to that company. Groq (key from
# https://console.groq.com/keys); this model can't stop thinking, so keep it short:
# OPENCALL_LLM_BASE_URL=https://api.groq.com/openai/v1
# OPENCALL_LLM_API_KEY=gsk_...
# OPENCALL_LLM_MODEL=openai/gpt-oss-20b
# OPENCALL_LLM_EXTRA_BODY={"reasoning_effort": "low"}
# ...or Google Gemini (key from https://aistudio.google.com/apikey):
# OPENCALL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENCALL_LLM_API_KEY=AIza...
# OPENCALL_LLM_MODEL=gemini-2.5-flash-lite
# OPENCALL_LLM_EXTRA_BODY={"reasoning_effort": "none"}

# --- Speech (all local) -----------------------------------------------------
# The main speech model, for English and any language without a model of its own.
# "small" is faster on a slow computer but worse at Indian languages.
OPENCALL_WHISPER_MODEL=large-v3-turbo
# Beam search width for callers' speech: 1 is quickest; 5 is a little more accurate
# (mostly Tamil) and 1.3 to 1.8 times slower.
# OPENCALL_WHISPER_BEAM_SIZE=1
# Telugu, Tamil and Hindi have models of their own (Whisper fine-tuned on each
# language; much more accurate, see docs/ARCHITECTURE.md). Replace or turn one off
# here, e.g. "ta=off" or "te=org/model@revision". Empty keeps the defaults.
OPENCALL_STT_MODELS=
# Your own spoken replies in English (the app's microphone during a call) use a
# small model: clear phone-mic speech, heard about 3x sooner on a CPU. "main" uses
# the main model instead.
OPENCALL_OWNER_STT_MODEL=small
# Which language each caller speaks: "voxlingua" (default; picks among the caller
# languages chosen in the app), "whisper" (Whisper's own guess) or "none" (then
# OPENCALL_CALLER_LANGUAGES below limits what Whisper may hear).
OPENCALL_LID_PROVIDER=voxlingua
# Only with OPENCALL_LID_PROVIDER=none: the languages callers speak, e.g. en,hi,te.
OPENCALL_CALLER_LANGUAGES=
# The assistant thinks in English and its replies are translated into the caller's
# language: "indictrans2" (about 500 MB, downloaded on first start) or "none".
OPENCALL_MT_PROVIDER=indictrans2
# "silero" (default) hears quiet speech and handles noisy lines; "energy" needs no extra install.
OPENCALL_VAD_PROVIDER=silero
OPENCALL_DEFAULT_VOICE=kokoro:af_heart
# Telugu voices from Piper (natural, fast on a CPU): "on" (default) or "off".
OPENCALL_PIPER_VOICES=on
# Voices for Tamil and other Indian languages: "mms" runs on any CPU.
# "parler" sounds more natural but needs an NVIDIA GPU, the indic-parler extra
# and a free Hugging Face token (HF_TOKEN) that has accepted the model's terms.
OPENCALL_INDIC_TTS=mms
# Indian-language voices to load at startup besides the callers' languages, so the
# first call in them isn't slow.
OPENCALL_INDIC_PRELOAD=te,ta

# --- Phone line, option 1: Bluetooth link to your own phone (free, no extra SIM)
# Run the server on the host (not in Docker) with BlueZ, oFono and PipeWire.
OPENCALL_BLUETOOTH_ENABLED=false
# Seconds the phone rings before the assistant picks up (so you can answer first).
OPENCALL_BLUETOOTH_ANSWER_DELAY_S=6
# Text delivery partners a map link through your phone (Android, needs bluez-obexd).
OPENCALL_BLUETOOTH_SMS=true

# --- Phone line, option 2: Asterisk + USB GSM modem with a spare SIM ---------
# Remove the # from these lines once you've set up Asterisk and the modem
# (docs/TELEPHONY.md). Until then the server reports "no phone line", and the
# app's practice calls still work.
# OPENCALL_ASTERISK_ARI_URL=http://host.docker.internal:8088/ari
# OPENCALL_ASTERISK_ARI_USER=opencall
# OPENCALL_ASTERISK_ARI_PASSWORD=change-me-too
# OPENCALL_ASTERISK_OUTBOUND_ENDPOINT=Quectel/quectel0/{number}
# Text delivery partners a map link from the modem SIM (leave the user empty to turn off).
# OPENCALL_ASTERISK_AMI_HOST=host.docker.internal
# OPENCALL_ASTERISK_AMI_USER=opencall
# OPENCALL_ASTERISK_AMI_PASSWORD=change-me-three
